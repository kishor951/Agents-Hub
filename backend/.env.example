# Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# IPFS (choose one)
IPFS_PROVIDER=nft.storage
NFT_STORAGE_API_KEY=your_nft_storage_api_key_here
# OR use Pinata
# PINATA_API_KEY=your_pinata_api_key
# PINATA_SECRET_KEY=your_pinata_secret

# Cardano
CARDANO_NETWORK=testnet
BLOCKFROST_PROJECT_ID=your_blockfrost_project_id_here

# OpenAI (for agent LLM)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Database (optional for MVP)
# DATABASE_URL=postgresql://user:password@localhost:5432/agents_hub

# Platform Settings
PLATFORM_FEE_PERCENTAGE=5
BREEDING_FEE_ADA=10
