# ============================================
# OPEN ROUTER API - LLM CONFIGURATION ✨ NEW!
# ============================================
OPEN_ROUTER_API_KEY=sk-or-v1-YOUR_API_KEY_HERE
REFERRER_URL=https://agents-hub.example.com

# ============================================
# CARDANO CONFIGURATION
# ============================================
CARDANO_NETWORK=testnet
BLOCKFROST_PROJECT_ID=previewXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SCRIPT_ADDRESS=addr_test1wq...
POLICY_ID=YOUR_POLICY_ID_HERE
PLATFORM_ADDRESS=addr_test1wq...

# ============================================
# IPFS/STORAGE CONFIGURATION
# ============================================
IPFS_PROVIDER=nft.storage
NFT_STORAGE_API_KEY=eyJhbGc...

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# PLATFORM SETTINGS
# ============================================
PLATFORM_FEE_PERCENTAGE=5
BREEDING_FEE_ADA=10

# ============================================
# HOW TO GET THESE KEYS (IMPORTANT!)
# ============================================
#
# 1️⃣  OPEN_ROUTER_API_KEY - LLM Integration
#    • Sign up: https://openrouter.io
#    • Keys: https://openrouter.io/keys
#    • Create new key (copy starts with sk-or-v1-)
#    • Free tier: Supports x-ai/grok-4.1-fast:free
#    • No credit card needed for free tier!
#
# 2️⃣  BLOCKFROST_PROJECT_ID - Cardano Node Access
#    • Sign up: https://blockfrost.io
#    • Create project for Cardano Testnet
#    • Free tier: Full access to all networks
#    • Unlimited requests
#
# 3️⃣  NFT_STORAGE_API_KEY - IPFS Pinning
#    • Sign up: https://nft.storage
#    • API Keys: https://nft.storage/manage
#    • Create new key and copy
#    • Free tier: 1GB storage included
#
# 4️⃣  CARDANO ADDRESSES
#    • Generate with wallet: Eternl, Nami, Flint
#    • Testnet faucet: https://testnets.cardano.org
#
# ============================================
# TESTING WITHOUT KEYS
# ============================================
# If OPEN_ROUTER_API_KEY is missing, backend returns
# mock responses for agent queries. Perfect for local testing!

